# apikey
OPENAI_API_KEY=
# api host
OPENAI_HOST=
# 模型名称
EMBEDDING_MODEL_NAME=
# embedding 向量维度
DIMENSIONS=1536
# 单次 Embedding 请求的最大文本条数
EMBEDDING_BATCH_SIZE=20
# 默认最多返回的知识库片段数及最低余弦相似度
SEARCH_TOP_K=5
SEARCH_SCORE_THRESHOLD=0.5
# jwt secret
JWT_SECRET=
# JWT expiration time in seconds
JWT_EXP_SECONDS=300
# debug web
IS_DEBUG=false
# database url
DATABASE_URL=
# Responses API chat configuration
CHAT_MODEL=
CHAT_API_HOST=
CHAT_API_KEY=
# 模型允许的最大上下文长度（Token）：请查看所用模型服务的说明。
# 32768 是保守的初始值，不代表系统已识别模型容量。
CHAT_CONTEXT_WINDOW=32768
# 可选：单次模型请求的总预算（Token），包含输入和回答预留。
# 一般保持默认即可；不得超过上面的模型容量，小容量模型请同时调低此值。
# 输入超出预算时自动压缩较早历史；输出预留和安全余量由代码提供默认值。
CHAT_CONTEXT_BUDGET=32768
# maximum number of function calls in one agent run
MAX_TOOL_CALLS=8
