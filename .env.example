# apikey
OPENAI_API_KEY=
# api host
OPENAI_HOST=
# 模型名称
EMBEDDING_MODEL_NAME=
# embedding 向量维度
DIMENSIONS=1536
# 单次 Embedding 请求的最大文本条数
EMBEDDING_BATCH_SIZE=20
# 默认最多返回的知识库片段数及最低余弦相似度
SEARCH_TOP_K=5
SEARCH_SCORE_THRESHOLD=0.5
# jwt secret
JWT_SECRET=
# JWT expiration time in seconds
JWT_EXP_SECONDS=300
# debug web
IS_DEBUG=false
# database url
DATABASE_URL=
# Responses API chat configuration
CHAT_MODEL=
CHAT_API_HOST=
CHAT_API_KEY=
# maximum number of function calls in one agent run
MAX_TOOL_CALLS=8
